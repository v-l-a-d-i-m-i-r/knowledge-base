  "main": "index.js",
  "scripts": {
    "build": "tsx ./src/build.ts",
    "lint:check": "npm run eslint:check && npm run stylelint:check && npm run prettier:check",
    "lint:fix": "npm run eslint:fix && npm run stylelint:fix && npm run prettier:fix",
    "dev": "rimraf dist && npm run build && concurrently \"nodemon\" \"browser-sync start --server 'dist' --files 'dist/**/*' --no-notify\"",
    "eslint:check": "eslint . --ext .ts",
    "eslint:fix": "eslint . --ext .ts --fix",
    "lint-staged": "lint-staged",
    "lint-staged:all": "lint-staged --diff='4b825dc642cb6eb9a060e54bf8d69288fbee4904'",
    "prepare": "husky",
    "prettier:check": "prettier --check \"**/*.{ts,js,json,md,css,scss}\"",
    "prettier:fix": "prettier --write \"**/*.{ts,js,json,md,css,scss}\"",
    "start": "tsx ./src/index.ts",
    "stylelint:check": "stylelint \"src/**/*.{scss,css}\"",
    "stylelint:fix": "stylelint \"src/**/*.{scss,css}\" --fix",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
